# QueueStorm Investigator — environment variables
#
# This service is intentionally offline and rule-based. There are no API
# keys, model endpoints, or external services required to run it.
#
# Copy this file to `.env` if you want to override any defaults. Django
# itself reads DJANGO_SECRET_KEY and DJANGO_DEBUG from the environment;
# nothing else is read.

# Django secret key. The default below is fine for local dev only.
# Set a strong random value when you deploy.
DJANGO_SECRET_KEY=dev-secret-change-me

# Set to "1" to enable Django debug mode. Leave as "0" for any
# non-local environment.
DJANGO_DEBUG=0

# Set to "1" to bind the dev server to 0.0.0.0 (useful inside a
# container or for testing from another machine on the LAN).
DJANGO_ALLOW_ALL_HOSTS=0